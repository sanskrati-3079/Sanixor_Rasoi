# Leave OPENAI_API_KEY empty to use the deterministic local mock provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# Optional. Defaults to the OpenAI Responses API.
OPENAI_BASE_URL=https://api.openai.com/v1

# Recipe book: folder for the SQLite database and uploaded photos/videos (default ./data)
DATA_DIR=
# Comma-separated usernames allowed to edit or delete any recipe (moderators)
ADMIN_USERNAMES=
